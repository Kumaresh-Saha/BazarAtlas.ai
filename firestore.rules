rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'email', 'preferredCity',
        'preferredTravelMode', 'accountRole', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'displayName', 'email', 'phone', 'preferredCity',
        'preferredTravelMode', 'accountRole', 'photoUrl', 'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
      && data.preferredCity is string && data.preferredCity.size() <= 80
      && data.preferredTravelMode in ['DRIVING', 'TWO_WHEELER', 'WALKING', 'TRANSIT']
      && data.accountRole in ['shopper', 'owner']
      && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidFavoriteShop(data) {
      return data.keys().hasAll([
        'userId', 'placeId', 'shopName', 'category', 'scale',
        'shortAddress', 'lat', 'lng', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'userId', 'placeId', 'shopName', 'category', 'scale',
        'shortAddress', 'lat', 'lng', 'note', 'createdAt', 'updatedAt'
      ])
      && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
      && data.placeId is string && isValidId(data.placeId)
      && data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 140
      && data.category in ['cloths', 'groceries', 'electronics', 'restaurant', 'household', 'cold_drinks', 'other']
      && data.scale in ['small', 'medium', 'large']
      && data.shortAddress is string && data.shortAddress.size() <= 240
      && data.lat is number && data.lat >= 5.0 && data.lat <= 38.0
      && data.lng is number && data.lng >= 67.0 && data.lng <= 98.0
      && (!('note' in data) || (data.note is string && data.note.size() <= 280))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidShopOwner(data) {
      return data.keys().hasAll([
        'placeId', 'ownerUid', 'ownerName', 'businessName', 'category',
        'businessScale', 'city', 'locality', 'goodsSummary',
        'deliveryAvailable', 'yearsInBusiness', 'isPublic', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'placeId', 'ownerUid', 'ownerName', 'businessName', 'category',
        'businessScale', 'city', 'locality', 'goodsSummary',
        'deliveryAvailable', 'yearsInBusiness', 'isPublic', 'createdAt', 'updatedAt'
      ])
      && data.placeId is string && isValidId(data.placeId)
      && data.ownerUid is string && data.ownerUid == request.auth.uid && isValidId(data.ownerUid)
      && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 100
      && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 140
      && data.category in ['cloths', 'groceries', 'electronics', 'restaurant', 'household', 'cold_drinks', 'other']
      && data.businessScale in ['small', 'medium', 'large']
      && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
      && data.locality is string && data.locality.size() >= 2 && data.locality.size() <= 200
      && data.goodsSummary is string && data.goodsSummary.size() >= 3 && data.goodsSummary.size() <= 300
      && data.deliveryAvailable is bool
      && data.yearsInBusiness is number && data.yearsInBusiness >= 0 && data.yearsInBusiness <= 200
      && data.isPublic is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidShopReview(data) {
      return data.keys().hasAll([
        'reviewId', 'placeId', 'authorUid', 'authorName',
        'rating', 'comment', 'isPublic', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'reviewId', 'placeId', 'authorUid', 'authorName',
        'rating', 'comment', 'isPublic', 'createdAt', 'updatedAt'
      ])
      && data.reviewId is string && isValidId(data.reviewId)
      && data.placeId is string && isValidId(data.placeId)
      && data.authorUid is string && data.authorUid == request.auth.uid && isValidId(data.authorUid)
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
      && data.rating is number && data.rating >= 1 && data.rating <= 5
      && data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 600
      && data.isPublic is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // 1. Private User Profile (Strict PII isolation)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isVerified() && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isVerified() && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'phone', 'preferredCity', 'preferredTravelMode',
          'accountRole', 'photoUrl', 'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isVerified() && isValidId(userId);

      // 2. Private Saved Favorites Subcollection
      match /favorites/{favoriteId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(favoriteId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isVerified() && isValidId(userId) && isValidId(favoriteId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidFavoriteShop(incoming())
          && incoming().placeId == favoriteId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isVerified() && isValidId(userId) && isValidId(favoriteId)
          && isValidFavoriteShop(incoming())
          && incoming().userId == existing().userId
          && incoming().placeId == existing().placeId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'note', 'shopName', 'category', 'scale', 'shortAddress', 'lat', 'lng', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isVerified() && isValidId(userId) && isValidId(favoriteId);
      }
    }

    // 3. Public Indian Shopkeeper & Business Owner Profiles
    match /shop_owners/{placeId} {
      allow get: if isValidId(placeId) && existing().isPublic == true;
      allow list: if existing().isPublic == true;
      allow create: if isSignedIn() && isVerified() && isValidId(placeId)
        && isValidShopOwner(incoming())
        && incoming().placeId == placeId
        && incoming().isPublic == true
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isVerified() && isValidId(placeId)
        && isValidShopOwner(incoming())
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().placeId == existing().placeId
        && incoming().isPublic == true
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerName', 'businessName', 'category', 'businessScale',
          'city', 'locality', 'goodsSummary', 'deliveryAvailable',
          'yearsInBusiness', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isVerified() && isValidId(placeId)
        && existing().ownerUid == request.auth.uid;
    }

    // 4. Public Customer Reviews
    match /shop_reviews/{reviewId} {
      allow get: if isValidId(reviewId) && existing().isPublic == true;
      allow list: if existing().isPublic == true;
      allow create: if isSignedIn() && isVerified() && isValidId(reviewId)
        && isValidShopReview(incoming())
        && incoming().reviewId == reviewId
        && incoming().isPublic == true
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isVerified() && isValidId(reviewId)
        && isValidShopReview(incoming())
        && existing().authorUid == request.auth.uid
        && incoming().authorUid == existing().authorUid
        && incoming().reviewId == existing().reviewId
        && incoming().placeId == existing().placeId
        && incoming().isPublic == true
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'rating', 'comment', 'authorName', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isVerified() && isValidId(reviewId)
        && existing().authorUid == request.auth.uid;
    }
  }
}
